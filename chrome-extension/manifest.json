{
  "manifest_version": 3,
  "name": "MeetingScribe",
  "description": "Live captions and recording controls for the MeetingScribe app (Mac / Windows).",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "MeetingScribe"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet-captions.js"]
    }
  ]
}
